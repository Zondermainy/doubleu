<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="#000000">

    <group
        android:rotation="45"
        android:pivotX="480"
        android:pivotY="480">

        <!-- Гриф (стал длиннее и чуть толще) -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M80,530L80,430L880,430L880,530Z"/>

        <!-- Левая сторона (блины стали выше и шире) -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M350,750L250,750L250,210L350,210Z" /> <!-- Большой -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M250,680L160,680L160,280L250,280Z" /> <!-- Средний -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M160,620L90,620L90,340L160,340Z" />   <!-- Маленький -->

        <!-- Правая сторона (блины стали выше и шире) -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M610,750L710,750L710,210L610,210Z" /> <!-- Большой -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M710,680L800,680L800,280L710,280Z" /> <!-- Средний -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M800,620L870,620L870,340L800,340Z" /> <!-- Маленький -->

    </group>
</vector>